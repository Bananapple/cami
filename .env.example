# Copy this file to .env and fill in values for each studio deployment

# Supabase — single multi-tenant project (v2 architecture)
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon-public-key>"

# Studio slug — identifies which studio row to load from the `studios` table.
# Must match the `slug` column value inserted during studio provisioning.
# If unset, the app attempts to derive the slug from the subdomain (e.g. yogabrie.brie.app → "yogabrie").
VITE_STUDIO_SLUG="yogabrie"

# Payment processor public key — only the publishable/frontend key goes here.
# Secret keys (STRIPE_SECRET_KEY, FRISBII_API_KEY, etc.) go ONLY in Supabase Edge Function env.
VITE_STRIPE_PUBLISHABLE_KEY="pk_live_..."
