# Copy this file to .env and fill in values for each studio deployment

# Supabase — create a new project at supabase.com for each studio
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon-public-key>"

# Payment processor public key (Stripe or Nets Easy / Dintero equivalent)
# The secret key must ONLY go in your Supabase Edge Function environment — never here
VITE_STRIPE_PUBLISHABLE_KEY="pk_live_..."
